  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "udp",
        "outboundTag": "block"
      },
      {
        "type": "field",
        "network": "tcp",
        "balancerTag": "auto-balancer"
      }
    ],
    "balancers": [
      {
        "tag": "auto-balancer",
        "selector": [
          "proxy_"
        ],
        "strategy": {
          "type": "leastPing"
        }
      }
    ]
  },
  "burstObservatory": {
    "subjectSelector": [
      "proxy_"
    ],
    "pingConfig": {
      "destination": "https://www.cloudflare.com/cdn-cgi/trace",
      "interval": "15s",
      "sampling": 2,
      "timeout": "3s"
    }
  }
